# Origin that serves articles. Published article links are permanent, so set
# this to your production origin even while developing locally.
PUBLIC_APP_ORIGIN=https://spool.at

# Redirect URIs for the browser extension's OAuth client (comma separated).
# Chrome: https://<extension-id>.chromiumapp.org/
# Firefox: the value of browser.identity.getRedirectURL()
PUBLIC_EXTENSION_REDIRECT_URIS=https://abcdefghijklmnopabcdefghijklmnop.chromiumapp.org/

# Optional: point at other infrastructure (self-hosting, tests).
# ATPROTO_PLC_URL=https://plc.directory
# ATPROTO_APPVIEW_URL=https://public.api.bsky.app
